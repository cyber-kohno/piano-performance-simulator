{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClavierDesk",
  "mainBinaryName": "clavierdesk",
  "version": "0.0.1",
  "identifier": "com.clavierdesk.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClavierDesk",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "ClavierDesk — Starting",
        "url": "splash.html",
        "width": 360,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#293b43",
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
